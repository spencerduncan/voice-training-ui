# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# design-sync (staged scripts, build output, machine state)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Node
node_modules/

# Unrelated local tooling
.design-sync/

# generated starter package (use make-starter.sh)
voice-garden-starter.zip

# reference-build audio cache (regenerate via scripts/build_reference_set.py)
.refcache/

# ── Your recordings stay yours 🌷 ──────────────────────────────────────────
# Voice takes, their analyses, and the log that indexes them are personal data.
# The starter ships these folders empty on purpose — only the .gitkeep
# placeholders are tracked — so nothing you record can ride along in a commit.
dashboard-react/public/audio/*
!dashboard-react/public/audio/.gitkeep
dashboard-react/public/analysis/*
!dashboard-react/public/analysis/.gitkeep
# matches both the root source-of-truth and the dashboard-react/public mirror
recordings.json
# per-take insights Claude authors from your recordings — personal too. Only
# the template is tracked.
dashboard-react/src/annotations/entries/*
!dashboard-react/src/annotations/entries/_example.tsx
